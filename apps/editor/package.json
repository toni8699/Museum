{
  "name": "@portfolio/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:vercel": "vite build && node scripts/inject-vercel-api-proxy.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "bench:record": "vite-node --config vitest.config.ts src/lib/bench/record-baseline.cli.ts --full"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@portfolio/camera-core": "*",
    "@portfolio/layout-core": "*",
    "@portfolio/project-model": "*",
    "@portfolio/scroll-travel": "*",
    "@threlte/core": "^8.0.4",
    "@threlte/extras": "^9.0.2",
    "lucide-svelte": "^1.0.1",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.1",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/three": "^0.175.0",
    "fflate": "^0.8.0",
    "svelte": "^5.34.0",
    "svelte-check": "^4.2.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
