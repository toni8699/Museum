[TEMPLATE]
# Copy to .env and adjust for local development (never commit .env). The
# workspace commands read process.env; export these values before running API
# commands, for example: `set -a; source .env; set +a`.
#
# Deployed equivalents: PUBLIC_API_ORIGIN goes in the Vercel project env;
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / SESSION_KEY / DATABASE_URL / PORT /
# EDITOR_ORIGIN / API_ORIGIN / R2_* are set as env vars on the Render service
# only.
# GOOGLE_CLIENT_SECRET and SESSION_KEY are private secrets — never expose them
# through public SvelteKit (PUBLIC_*) environment variables.
#
# Production must use sibling custom domains under one registrable domain (for
# example https://editor.example.com and https://api.example.com). The default
# Vercel/Render hostnames are cross-site and are for development smoke only.

# --- @biskiq/api (apps/api) — read from process.env via readConfig ---

# Required for the API. Use a local Postgres or dedicated Neon development
# database here — never copy the production DATABASE_URL into local .env.
# `npm run migrate:api` changes whichever database this value targets.
DATABASE_URL=postgres://user:password@localhost:5432/biskiq

# Required. Port the API listens on (Render injects PORT on deploy).
PORT=8787

# Required for the Google OIDC flow (P19). Owner-approved Google OAuth web
# application; the Google console redirect URI must be {API origin}/auth/callback.
GOOGLE_CLIENT_ID=google-client-id

# Required for the Google OIDC flow (P19). Private — never PUBLIC_*.
GOOGLE_CLIENT_SECRET=google-client-secret

# Required for the Google OIDC flow (P19). 32-byte key for
# @fastify/secure-session; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_KEY=base64-32-byte-session-key

# Required. Allowed editor origin for credentialed cross-origin CORS and the
# post-login redirect. No wildcard is permitted.
EDITOR_ORIGIN=http://localhost:5173
# Hosted staging example (use the stable Vercel production origin, not a
# changing preview URL): https://your-editor.vercel.app

# Required in deployment: pin the public API base URL for the exact Google
# callback URL. It may include the Vercel proxy path and may be omitted only
# for local host-derived development.
API_ORIGIN=http://localhost:8787
# Hosted staging example: https://your-editor.vercel.app/api
# Google authorized redirect URI: https://your-editor.vercel.app/api/auth/callback

# Required for P20 project asset bytes. The endpoint is the private
# Cloudflare R2 S3-compatible endpoint; credentials never enter the editor.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=biskiq-assets-store
R2_ACCESS_KEY_ID=r2-access-key
R2_SECRET_ACCESS_KEY=r2-secret-key

# --- @portfolio/editor (apps/editor) — read at runtime via $env/dynamic/public ---

# Optional. Base URL of the deployed @biskiq/api. Leave unset to keep the
# cloud Save/Load UI disabled (P19 behavior).
PUBLIC_API_ORIGIN=http://localhost:8787
# Hosted staging value: https://your-editor.vercel.app/api
